{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:file((?!\\.well-known(?:/.*)?)(?:[^/]+/)*[^/]+\\.\\w+)/",
      "destination": "/:file",
      "internal": true,
      "missing": [
        {
          "type": "header",
          "key": "x-nextjs-data"
        }
      ],
      "statusCode": 308,
      "regex": "^(?:/((?!\\.well-known(?:/.*)?)(?:[^/]+/)*[^/]+\\.\\w+))/$"
    },
    {
      "source": "/:notfile((?!\\.well-known(?:/.*)?)(?:[^/]+/)*[^/\\.]+)",
      "destination": "/:notfile/",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?!\\.well-known(?:/.*)?)(?:[^/]+/)*[^/\\.]+))$"
    },
    {
      "source": "/rent",
      "destination": "/",
      "statusCode": 301,
      "regex": "^(?!/_next)/rent(?:/)?$"
    },
    {
      "source": "/rent/:path*",
      "destination": "/",
      "statusCode": 301,
      "regex": "^(?!/_next)/rent(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/services/land-investment",
      "destination": "/services/",
      "statusCode": 301,
      "regex": "^(?!/_next)/services/land-investment(?:/)?$"
    },
    {
      "source": "/industries",
      "destination": "/services/",
      "statusCode": 301,
      "regex": "^(?!/_next)/industries(?:/)?$"
    },
    {
      "source": "/services/company-registration",
      "destination": "/services/pvt-registration/",
      "statusCode": 301,
      "regex": "^(?!/_next)/services/company-registration(?:/)?$"
    },
    {
      "source": "/services/consulting",
      "destination": "/services/business-consulting/",
      "statusCode": 301,
      "regex": "^(?!/_next)/services/consulting(?:/)?$"
    },
    {
      "source": "/services/registration",
      "destination": "/services/business-registration/",
      "statusCode": 301,
      "regex": "^(?!/_next)/services/registration(?:/)?$"
    },
    {
      "source": "/business-registration",
      "destination": "/services/business-registration/",
      "statusCode": 301,
      "regex": "^(?!/_next)/business-registration(?:/)?$"
    },
    {
      "source": "/business-consulting",
      "destination": "/services/business-consulting/",
      "statusCode": 301,
      "regex": "^(?!/_next)/business-consulting(?:/)?$"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ],
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/blog/[slug]",
      "regex": "^/blog/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/blog/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/services/[slug]",
      "regex": "^/services/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/services/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[city]",
      "regex": "^/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcity": "nxtPcity"
      },
      "namedRegex": "^/(?<nxtPcity>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[city]/[service]",
      "regex": "^/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcity": "nxtPcity",
        "nxtPservice": "nxtPservice"
      },
      "namedRegex": "^/(?<nxtPcity>[^/]+?)/(?<nxtPservice>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/about",
      "regex": "^/about(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about(?:/)?$"
    },
    {
      "page": "/blog",
      "regex": "^/blog(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/blog(?:/)?$"
    },
    {
      "page": "/compare",
      "regex": "^/compare(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/compare(?:/)?$"
    },
    {
      "page": "/contact",
      "regex": "^/contact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/contact(?:/)?$"
    },
    {
      "page": "/disclaimer",
      "regex": "^/disclaimer(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/disclaimer(?:/)?$"
    },
    {
      "page": "/faqs",
      "regex": "^/faqs(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/faqs(?:/)?$"
    },
    {
      "page": "/gujarat",
      "regex": "^/gujarat(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/gujarat(?:/)?$"
    },
    {
      "page": "/og",
      "regex": "^/og(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/og(?:/)?$"
    },
    {
      "page": "/privacy",
      "regex": "^/privacy(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/privacy(?:/)?$"
    },
    {
      "page": "/rentals",
      "regex": "^/rentals(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/rentals(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/robots\\.txt(?:/)?$"
    },
    {
      "page": "/services",
      "regex": "^/services(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services(?:/)?$"
    },
    {
      "page": "/services/business-consulting",
      "regex": "^/services/business\\-consulting(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services/business\\-consulting(?:/)?$"
    },
    {
      "page": "/services/business-registration",
      "regex": "^/services/business\\-registration(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services/business\\-registration(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    },
    {
      "page": "/team",
      "regex": "^/team(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/team(?:/)?$"
    },
    {
      "page": "/terms",
      "regex": "^/terms(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/terms(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}