2:T425,{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://www.raulji.com/#organization","name":"Raulji Group","url":"https://www.raulji.com/","description":"Business registration and business-growth support for entrepreneurs and businesses across Gujarat and India.","email":"admin@raulji.com","telephone":"+918511187689","address":{"@type":"PostalAddress","addressLocality":"Vadodara","addressRegion":"Gujarat","addressCountry":"IN"},"areaServed":[{"@type":"AdministrativeArea","name":"Gujarat"},{"@type":"Country","name":"India"}],"contactPoint":{"@type":"ContactPoint","telephone":"+918511187689","email":"admin@raulji.com","contactType":"customer service","areaServed":"IN","availableLanguage":["en","gu","hi"]}},{"@type":"WebSite","@id":"https://www.raulji.com/#website","url":"https://www.raulji.com/","name":"Raulji Group","description":"Business registration and business-growth support for entrepreneurs and businesses across Gujarat and India.","publisher":{"@id":"https://www.raulji.com/#organization"},"inLanguage":"en-IN"}]}0:{"P":null,"b":"7cTPNpJPmEpiVaeLssaRM","p":"","c":["","faqs",""],"i":false,"f":[[["",{"children":["faqs",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",["$","$1","c",{"children":[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/b91cebc825847f38.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}]],["$","html",null,{"lang":"en-IN","className":"__variable_48b81b","children":["$","body",null,{"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","a",null,{"href":"#main","className":"skip-link","children":"Skip to main content"}],["$","$L3",null,{"children":[["$","$L4",null,{}],["$","main",null,{"id":"main","className":"mobile-bar-gutter","children":["$","$L5",null,{"parallelRouterKey":"children","error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L6",null,{}],"templateS