2d:["$","section",null,{"className":"pb-12 pt-8","children":["$","div",null,{"className":"container-wide","children":["$","div",null,{"className":"grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16","children":[["$","div",null,{"children":[["$","p",null,{"className":"mb-4 inline-flex items-center gap-2 rounded-full border border-primary/25 bg-accent px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-primary","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-map-pin h-3.5 w-3.5","aria-hidden":"true","children":[["$","path","1r0f0z",{"d":"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"}],["$","circle","ilqhr7",{"cx":"12","cy":"10","r":"3"}],"$undefined"]}],"Ahmedabad",", ","Ahmedabad"," district"]}],["$","h1",null,{"className":"text-balance text-3xl leading-tight md:text-4xl lg:text-[2.75rem]","children":"Private Limited Company Registration in Ahmedabad"}],["$","div",null,{"className":"mt-5 space-y-4 text-pretty leading-relaxed text-muted-foreground","children":[["$","p","Ahmedabad produces more Private Limited ",{"children":"Ahmedabad produces more Private Limited incorporations than any other city in Gujarat, and the reason is mostly about funding. The city holds the state's deepest concentration of founders who intend to raise external capital, clustered along the SG Highway corridor, Prahlad Nagar and Bodakdev, and equity investors will not put money into anything other than a company."}],["$","p","There is a second, quieter pattern here ",{"children":"There is a second, quieter pattern here that has nothing to do with startups. Established textile, chemical and trading families around Ashram Road, CG Road and the walled city often incorporate a company to hold a new venture, keeping it legally separate from the legacy partnership firm that carries the family's older business. The company is the vehicle for the new thing, not a replacement for the old one."}],["$","p","A useful local detail: the Registrar of ",{"children":"A useful local detail: the Registrar of Companies for Gujarat sits in Ahmedabad. That makes no difference to how an Ahmedabad incorporation is processed, since filing is online through the MCA portal, but it does mean the office your documents reach is in your own city."}]]}],["$","div",null,{"className":"mt-8 flex flex-col gap-3 sm:flex-row","children":[["$","$L7",null,{"href":"#enquiry","className":"brand-gradient inline-flex min-h-[3.25rem] items-center justify-center gap-2 rounded-xl px-7 font-semibold text-primary-foreground shadow-soft","children":["Talk to an Expert",["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right h-4 w-4","aria-hidden":"true","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}],["$","$L7",null,{"href":"/services/pvt-registration/","className":"inline-flex min-h-[3.25rem] items-center justify-center rounded-xl border-2 border-primary px-7 font-semibold text-primary transition-colors hover:bg-primary hover:text-primary-foreground","children":["Full ","Private Limited"," guide"]}]]}]]}],["$","div",null,{"className":"rounded-2xl border border-border bg-muted p-7","children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-muted-foreground","children":"At a glance"}],["$","dl",null,{"className":"mt-5 space-y-4 text-sm","children":[["$","div","Structure",{"className":"border-l-2 border-primary/30 pl-4","children":["$L35","$L36"]}],"$L37","$L38","$L39","$L3a"]}],"$L3b"]}]]}]}]}]
