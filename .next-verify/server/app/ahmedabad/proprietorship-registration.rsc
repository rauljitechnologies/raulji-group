43:["$","div",null,{"children":[["$","h2",null,{"className":"text-2xl md:text-3xl","children":"How the process runs"}],["$","ol",null,{"className":"mt-6 space-y-4","children":[["$","li","Decide the business name and activity",{"className":"flex gap-4","children":[["$","span",null,{"className":"inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-accent text-sm font-bold text-primary","aria-hidden":"true","children":1}],["$","div",null,{"children":[["$","h3",null,{"className":"text-base font-bold text-secondary","children":"Decide the business name and activity"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-muted-foreground","children":"A proprietorship trades under a business name that is not separately incorporated. We screen the name against registered trade marks so the business is not building recognition on a name it may later have to stop using."}]]}]]}],["$","li","Udyam (MSME) registration",{"className":"flex gap-4","children":[["$","span",null,{"className":"inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-accent text-sm font-bold text-primary","aria-hidden":"true","children":2}],["$","div",null,{"children":[["$","h3",null,{"className":"text-base font-bold text-secondary","children":"Udyam (MSME) registration"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-muted-foreground","children":"Udyam registration is free, is completed on the government portal against the proprietor's Aadhaar and PAN, and produces a certificate with a Udyam number. It is the most widely accepted proof that a proprietorship exists."}]]}]]}],["$","li","GST registration, where applicable",{"className":"flex gap-4","children":[["$","span",null,{"className":"inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-accent text-sm font-bold text-primary","aria-hidden":"true","children":3}],["$","div",null,{"children":[["$","h3",null,{"className":"text-base font-bold text-secondary","children":"GST registration, where applicable"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-muted-foreground","children":"GST registration is compulsory once turnover crosses the applicable threshold, and irrespective of turnover for inter-state supply of goods, e-commerce supply and certain other categories. Where it is not compulsory, some proprietors still register voluntarily because customers ask for a GST invoice."}]]}]]}],["$","li","Shop and establishment registration",{"className":"flex gap-4","children":[["$","span",null,{"className":"inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-accent text-sm font-bold text-primary","aria-hidden":"true","children":4}],["$","div",null,{"children":[["$","h3",null,{"className":"text-base font-bold text-secondary","children":"Shop and establishment registration"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-muted-foreground","children":"Most states require a shop and establishment registration for a commercial premises. In Gujarat this is handled under the state's shops and establishments legislation through the local authority, and requirements vary by municipality."}]]}]]}],["$","li","Any activity-specific licences",{"className":"flex gap-4","children":[["$","span",null,{"className":"inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-accent text-sm font-bold text-primary","aria-hidden":"true","children":5}],["$","div",null,{"children":[["$","h3",null,{"className":"text-base font-bold text-secondary","children":"Any activity-specific licences"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-muted-foreground","children":"Some activities need their own licence, such as FSSAI for food businesses, Import Export Code for import or export, or a professional tax registration where the state levies it."}]]}]]}],"$L4a"]}],"$L4b"]}]
44:["$","p",null,{"className":"leading-relaxed","children":"The usual triggers are taking on real liability, bringing in a partner, or needing a structure a customer will contract with. A proprietorship cannot have a second owner, so the moment someone else is genuinely involved you need a firm, an LLP or a company. If it is liability that has changed, an LLP is generally the lowest-cost next step."}]
