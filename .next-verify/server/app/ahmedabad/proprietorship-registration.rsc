32:["$","section",null,{"id":"$undefined","className":"section-padding","children":["$","div",null,{"className":"container-wide","children":[["$","div",null,{"className":"mb-12 max-w-3xl","children":[["$","p",null,{"className":"mb-3 text-sm font-semibold uppercase tracking-wider text-primary","children":"Local considerations"}],["$","h2",null,{"className":"text-3xl md:text-4xl lg:text-[2.75rem] lg:leading-tight","children":"What is worth checking in Ahmedabad"}],["$","p",null,{"className":"mt-4 text-lg leading-relaxed text-muted-foreground","children":"These are the points that actually differ by market, rather than the general features of the structure."}]]}],["$","ol",null,{"className":"grid gap-px overflow-hidden rounded-2xl border border-border bg-border md:grid-cols-2","children":[["$","li","GST is what online sellers actually need",{"className":"bg-card p-6 sm:p-7","children":[["$","p",null,{"className":"text-sm font-semibold text-primary","children":"01"}],["$","h3",null,{"className":"mt-2 text-lg","children":"GST is what online sellers actually need"}],["$","p",null,{"className":"mt-2.5 leading-relaxed text-muted-foreground","children":"The turnover thresholds do not help you if you sell interstate or through a marketplace: those require GST registration from the first sale. For Ahmedabad's large number of home-based online sellers, GST registration is effectively the business registration, and it is the first thing we set up."}]]}],["$","li","Shop and establishment registration is a local obligation",{"className":"bg-card p-6 sm:p-7","children":[["$","p",null,{"className":"text-sm font-semibold text-primary","children":"02"}],["$","h3",null,{"className":"mt-2 text-lg","children":"Shop and establishment registration is a local obligation"}],["$","p",null,{"className":"mt-2.5 leading-relaxed text-muted-foreground","children":"A commercial establishment in Ahmedabad falls under the Gujarat Shops and Establishments (Regulation of Employment and Conditions of Service) Act, administered locally by the Ahmedabad Municipal Corporation. It is the registration that most clearly evidences a business premises, and banks often ask for it when opening a current account in a trade name."}]]}],["$","li","Udyam registration is free and worth having",{"className":"bg-card p-6 sm:p-7","children":[["$","p",null,{"className":"text-sm font-semibold text-primary","children":"03"}],["$","h3",null,{"className":"mt-2 text-lg","children":"Udyam registration is free and worth having"}],["$","p",null,{"className":"mt-2.5 leading-relaxed text-muted-foreground","children":"Udyam is the MSME registration, it costs nothing, and it is what makes a small Ahmedabad business eligible for MSME benefits, including the protections on delayed payments that matter when your customers are larger firms. It is not a substitute for GST, and nobody should be charging you a large fee for it."}]]}],["$","li","Your liability is unlimited, with no separation at all",{"className":"bg-card p-6 sm:p-7","children":[["$","p",null,{"className":"text-sm font-semibold text-primary","children":"04"}],["$","h3",null,{"className":"mt-2 text-lg","children":"Your liability is unlimited, with no separation at all"}],["$","p",null,{"className":"mt-2.5 leading-relaxed text-muted-foreground","children":"You and the business are the same person in law. Business debts are your debts, and the business income is taxed as your personal income at slab rates. For a small business that is often the right trade, but once you take on premises, staff, stock on credit or any real risk, it is worth revisiting."}]]}]]}]]}]}]
