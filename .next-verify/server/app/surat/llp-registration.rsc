lassName":"flex gap-3 leading-relaxed text-secondary","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check mt-1 h-4 w-4 shrink-0 text-primary","aria-hidden":"true","children":[["$","path","1gmf2c",{"d":"M20 6 9 17l-5-5"}],"$undefined"]}],["$","span",null,{"children":"Weaving, processing and job-work units converting from a partnership firm"}]]}],["$","li","Export trading firms whose buyers want a limited-liability counterparty",{"className":"flex gap-3 leading-relaxed text-secondary","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check mt-1 h-4 w-4 shrink-0 text-primary","aria-hidden":"true","children":[["$","path","1gmf2c",{"d":"M20 6 9 17l-5-5"}],"$undefined"]}],["$","span",null,{"children":"Export trading firms whose buyers want a limited-liability counterparty"}]]}],["$","li","Family businesses wanting liability capped without a company's compliance load",{"className":"flex gap-3 leading-relaxed text-secondary","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check mt-1 h-4 w-4 shrink-0 text-primary","aria-hidden":"true","children":[["$","path","1gmf2c",{"d":"M20 6 9 17l-5-5"}],"$undefined"]}],["$","span",null,{"children":"Family businesses wanting liability capped without a company's compliance load"}]]}]]}]]}]}]}]
2f:["$","section",null,{"id":"$undefined","className":"section-padding","children":["$","div",null,{"className":"container-wide","children":[["$","div",null,{"className":"mb-12 max-w-3xl","children":[["$","p",null,{"className":"mb-3 text-sm font-semibold uppercase tracking-wider text-primary","children":"Local considerations"}],["$","h2",null,{"className":"text-3xl md:text-4xl lg:text-[2.75rem] lg:leading-tight","children":"What is worth checking in Surat"}],["$","p",null,{"className":"mt-4 text-lg leading-relaxed text-muted-foreground","children":"These are the points that actually differ by market, rather than the general features of the structure."}]]}],["$","ol",null,{"className":"grid gap-px overflow-hidden rounded-2xl border border-border bg-border md:grid-cols-2","children":[["$","li","It is the natural conversion from a partnership firm",{"className":"bg-card p-6 sm:p-7","children":[["$","p",null,{"className":"text-sm font-semibold text-primary","children":"01"}],["$","h3",null,{"className":"mt-2 text-lg","children":"It is the natural conversion from a partnership firm"}],["$","p",null,{"className":"mt-2.5 leading-relaxed text-muted-foreground","children":"An LLP keeps what works about a Surat partnership, the partner structure and the profit shares, and fixes what does not, the unlimited personal liability. The existing deed's commercial terms carry over into the LLP Agreement. Compared with incorporating a company, you avoid statutory audit from the first year and the board formalities, which for a family trading firm is the difference between workable and burdensome."}]]}],["$","li","The conversion touches everything operational",{"className":"bg-card p-6 sm:p-7","children":[["$","p",null,{"className":"text-sm font-semibold text-primary","children":"02"}],["$","h3",null,{"className":"mt-2 text-lg","children":"The conversion touches everything operational"}],["$","p",null,{"className":"mt-2.5 leading-relaxed text-muted-foreground","children":"The LLP takes a new PAN, so bank mandates, GST registration, buyer and supplier records, and any credit facility need to be moved across. In a trade with live credit lines and ongoing orders, the sequencing matters more than the paperwork. Plan the transition around your payment cycle rather than in the middle of one."}]]}],["$","li","Audit only above thresholds, but filings always",{"className":"bg-card p-6 sm:p-7","children":[["$","p",null,{"className":"text-sm font-semibold text-primary","children":"03"}],["$","h3",null,{"className":"mt-2 text-lg","children":"Audit only above thresholds, but filings always"}],["$","p",null,{"className":"mt-2.5 leading-relaxed text-muted-foreground","children":"An LLP requires audit only once turnover exceeds Rs 40 lakh or contribution exceeds Rs 25 lakh, which many Surat firms will cross, so budget for it. Regardless of audit, Form 11 is due by 30 May and Form 8 by 30 October every year, including a year with no activity, and late filing carries a per-day penalty that keeps accruing."}]]}],["$","li","No equity, which rules out investment",{"className":"bg-card p-6 sm:p-7","children":[["$","p",null,{"className":"text-sm font-semibold text-primary","children":"04"}],["$","h3",null,{"className":"mt-2 text-lg","children":"No equity, which rules out investment"}],["$","p",null,{"className":"mt-2.5 leading-relaxed text-muted-foreground","children":"An LLP cannot issue equity shares. For a trading or processing firm that is usually irrelevant. For a Surat textile business planning to build a consumer brand and raise money for it, it is decisive, and a company is the right structure from the start rather than after a costly conversion."}]]}]]}]]}]}]
