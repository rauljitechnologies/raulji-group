23:["$","section",null,{"className":"pb-12 pt-8","children":["$","div",null,{"className":"container-wide","children":["$","div",null,{"className":"max-w-3xl","children":[["$","p",null,{"className":"text-sm font-semibold uppercase tracking-wider text-primary","children":"Business Registration"}],["$","h1",null,{"className":"mt-3 text-balance text-3xl leading-tight md:text-4xl lg:text-5xl","children":"Business Registration Services in India"}],["$","p",null,{"className":"mt-5 text-pretty text-lg leading-relaxed text-muted-foreground","children":"A business in India can be registered in four main forms. They differ in who carries the liability, how much annual compliance they attract, and whether the business can raise equity. This page covers how to choose between them and what registration involves. The detail for each one is on its own page."}]]}]}]}]
