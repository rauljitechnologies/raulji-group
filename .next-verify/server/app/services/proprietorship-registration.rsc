53:["$","li","Open a current account",{"className":"relative","children":[["$","span",null,{"aria-hidden":"true","className":"brand-gradient absolute -left-[2.6rem] flex h-8 w-8 items-center justify-center rounded-full text-sm font-bold text-primary-foreground","children":6}],["$","h3",null,{"className":"text-lg","children":[["$","span",null,{"className":"sr-only","children":["Step ",6,": "]}],"Open a current account"]}],["$","p",null,{"className":"mt-2 leading-relaxed text-muted-foreground","children":"Banks open a current account in the business name against the proprietor's PAN and Aadhaar together with the business registration proofs. Under RBI KYC norms most banks ask for two such proofs, which is why Udyam plus GST or a shop licence is the usual combination."}]]}]
