2f:["$","section",null,{"id":"$undefined","className":"section-padding","children":["$","div",null,{"className":"container-wide","children":[["$","div",null,{"className":"mb-12 max-w-3xl","children":[null,["$","h2",null,{"className":"text-3xl md:text-4xl lg:text-[2.75rem] lg:leading-tight","children":"Benefits of Private Limited"}],null]}],["$","ul",null,{"className":"grid gap-6 md:grid-cols-2 lg:grid-cols-3","children":[["$","li","Separate legal entity",{"className":"rounded-2xl border border-border bg-card p-6","children":[["$","h3",null,{"className":"text-lg","children":"Separate legal entity"}],["$","p",null,{"className":"mt-2 leading-relaxed text-muted-foreground","children":"The company can own property, borrow, sue and be sued in its own name. Its assets and obligations are legally distinct from those of its shareholders."}]]}],["$","li","Limited liability",{"className":"rounded-2xl border border-border bg-card p-6","children":[["$","h3",null,{"className":"text-lg","children":"Limited liability"}],["$","p",null,{"className":"mt-2 leading-relaxed text-muted-foreground","children":"A shareholder's liability is limited to any amount remaining unpaid on their shares. Personal assets are not exposed to the company's business debts, subject to the exceptions in law."}]]}],["$","li","Perpetual succession",{"className":"rounded-2xl border border-border bg-card p-6","children":[["$","h3",null,{"className":"text-lg","children":"Perpetual succession"}],["$","p",null,{"className":"mt-2 leading-relaxed text-muted-foreground","children":"The company continues to exist regardless of changes in shareholding, the death of a member, or the exit of a director, until it is formally wound up or struck off."}]]}],["$","li","Preferred by investors",{"className":"rounded-2xl border border-border bg-card p-6","children":[["$","h3",null,{"className":"text-lg","children":"Preferred by investors"}],["$","p",null,{"className":"mt-2 leading-relaxed text-muted-foreground","children":"Equity shares can be issued and transferred, which makes the structure workable for priced rounds, convertible instruments and ESOP pools. LLPs and partnership firms cannot issue equity."}]]}],["$","li","Credibility with counterparties",{"className":"rounded-2xl border border-border bg-card p-6","children":[["$","h3",null,{"className":"text-lg","children":"Credibility with counterparties"}],["$","p",null,{"className":"mt-2 leading-relaxed text-muted-foreground","children":"Incorporation details, directors and charges are on the public MCA register, which many banks, large customers and tender processes expect to be able to verify."}]]}]]}]]}]}]
