30:["$","section",null,{"className":"pb-12 pt-8","children":["$","div",null,{"className":"container-wide","children":["$","div",null,{"className":"grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16","children":[["$","div",null,{"children":[["$","p",null,{"className":"mb-4 inline-flex items-center gap-2 rounded-full border border-primary/25 bg-accent px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-primary","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-map-pin h-3.5 w-3.5","aria-hidden":"true","children":[["$","path","1r0f0z",{"d":"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"}],["$","circle","ilqhr7",{"cx":"12","cy":"10","r":"3"}],"$undefined"]}],"Vadodara",", ","Vadodara"," district"]}],["$","h1",null,{"className":"text-balance text-3xl leading-tight md:text-4xl lg:text-[2.75rem]","children":"Partnership Firm Registration in Vadodara"}],["$","div",null,{"className":"mt-5 space-y-4 text-pretty leading-relaxed text-muted-foreground","children":[["$","p","Partnership firms are still common in Va",{"children":"Partnership firms are still common in Vadodara's smaller industrial economy, particularly among fabrication workshops, machining job shops and trading businesses in and around Makarpura and Nandesari. Two or three people, often related or long-standing colleagues, put in machinery and working capital and run the business together."}],["$","p","It is a genuinely suitable structure for",{"children":"It is a genuinely suitable structure for that, and it is cheap and quick to form. The two things worth thinking hard about are specific to this kind of business. First, the partners carry unlimited personal liability, and a workshop that buys machinery on credit or takes on fabrication work with penalty clauses is carrying real exposure."}],["$","p","Second, in a workshop partnership the as",{"children":"Second, in a workshop partnership the assets matter more than in a trading firm. Who actually owns the lathe, the press, the welding sets? If a partner brought machinery in rather than cash, the deed needs to say whether that machinery became the firm's property or stayed theirs. Vadodara workshop disputes are far more often about equipment than about profit."}]]}],["$","div",null,{"className":"mt-8 flex flex-col gap-3 sm:flex-row","children":[["$","$L7",null,{"href":"#enquiry","className":"brand-gradient inline-flex min-h-[3.25rem] items-center justify-center gap-2 rounded-xl px-7 font-semibold text-primary-foreground shadow-soft","children":["Talk to an Expert",["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right h-4 w-4","aria-hidden":"true","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}],["$","$L7",null,{"href":"/services/partnership-registration/","className":"inline-flex min-h-[3.25rem] items-center justify-center rounded-xl border-2 border-primary px-7 font-semibold text-primary transition-colors hover:bg-primary hover:text-primary-foreground","children":["Full ","Partnership"," guide"]}]]}]]}],["$","div",null,{"className":"rounded-2xl border border-border bg-muted p-7","children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-muted-foreground","children":"At a glance"}],["$","dl",null,{"className":"mt-5 space-y-4 text-sm","children":[["$","div","Structure",{"className":"border-l-2 border-primary/30 pl-4","children":["$L38","$L39"]}],"$L3a","$L3b","$L3c","$L3d"]}],"$L3e"]}]]}]}]}]
