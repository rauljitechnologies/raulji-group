34:["$","section",null,{"id":"$undefined","className":"section-padding","children":["$","div",null,{"className":"container-wide","children":[["$","div",null,{"className":"mb-12 max-w-3xl mx-auto text-center","children":[["$","p",null,{"className":"mb-3 text-sm font-semibold uppercase tracking-wider text-primary","children":"FAQs"}],["$","h2",null,{"className":"text-3xl md:text-4xl lg:text-[2.75rem] lg:leading-tight","children":"Private Limited in Rajkot: common questions"}],null]}],["$","div",null,{"className":"mx-auto max-w-3xl divide-y divide-border rounded-2xl border border-border bg-card","children":[["$","details","Do OEM buyers require Rajkot suppliers to be a Private Limited Company?",{"className":"group","id":"rajkot-pvt-registration-faq-1","name":"rajkot-pvt-registration-faq","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-start justify-between gap-4 px-5 py-5 text-left font-semibold text-secondary marker:hidden hover:bg-muted/60 sm:px-6","children":[["$","span",null,{"children":"Do OEM buyers require Rajkot suppliers to be a Private Limited Company?"}],["$","span",null,{"aria-hidden":"true","className":"mt-1 shrink-0 text-xl leading-none text-primary transition-transform duration-200 group-open:rotate-45","children":"+"}]]}],["$","div",null,{"className":"px-5 pb-6 text-muted-foreground sm:px-6","children":["$","p",null,{"className":"leading-relaxed","children":"Some do, many do not. Most vendor onboarding checks want an entity that can be verified on a public register, and an LLP meets that at considerably lower annual cost. A minority of OEM processes specify a company, and some require audited accounts for past years. Since you normally know which buyer prompted the question, read their vendor form before choosing."}]}]]}],["$","details","Will a company protect me personally if I borrow for machinery?",{"className":"group","id":"rajkot-pvt-registration-faq-2","name":"rajkot-pvt-registration-faq","children":[["$","summary