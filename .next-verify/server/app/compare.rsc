[["$","th",null,{"scope":"row","className":"sticky left-0 z-10 bg-card px-5 py-4 font-semibold text-secondary","children":"Governing law"}],["$","td",null,{"className":"px-5 py-4 leading-relaxed text-muted-foreground","children":"Companies Act, 2013"}],["$","td",null,{"className":"px-5 py-4 leading-relaxed text-muted-foreground","children":"Limited Liability Partnership Act, 2008"}],["$","td",null,{"className":"px-5 py-4 leading-relaxed text-muted-foreground","children":"Indian Partnership Act, 1932"}],["$","td",null,{"className":"px-5 py-4 leading-relaxed text-muted-foreground","children":"No dedicated statute; governed by the registrations held"}]]}],["$","tr","Separate legal identity",{"className":"align-top","children":[["$","th",null,{"scope":"row","className":"sticky left-0 z-10 bg-card px-5 py-4 font-semibold text-secondary","children":"Separate legal identity"}],["$","td",null,{"className":"px-5 py-4 leading-relaxed text-muted-foreground","children":"Yes. The company is distinct from its shareholders and can own property and contract in its own name."}],["$","td",null,{"className":"px-5 py-4 leading-relaxed text-muted-foreground","children":"Yes. The LLP is a body corporate distinct from its partners."}],["$","td",null,{"className":"px-5 py-4 leading-relaxed text-muted-foreground","children":"No. The firm has no legal identity separate from its partners, though it can be registered with the Registrar of Firms."}],["$","td",null,{"className":"px-5 py-4 leading-relaxed text-muted-foreground","children":"No. The proprietor and the business are the same person in law."}]]}],["$","tr","Owners or partners",{"className":"align-top","children":[["$","th",null,{"scope":"row","className":"sticky left-0 z-10 bg-card px-5 py-4 font-semibold text-secondary","children":"Owners or partners"}],["$","td",null,{"className":"px-5 py-4 leading-relaxed text-muted-foreground","children":"2 to 200 shareholders; minimum 2 directors, at least one resident in India"}],["$","td",null,