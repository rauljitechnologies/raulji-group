33:["$","tr","Raising equity investment",{"className":"align-top","children":[["$","th",null,{"scope":"row","className":"sticky left-0 z-10 bg-card px-5 py-4 font-semibold text-secondary","children":"Raising equity investment"}],["$","td",null,{"className":"px-5 py-4 leading-relaxed text-muted-foreground","children":"Yes. Shares can be issued and transferred, and an ESOP pool created."}],["$","td",null,{"className":"px-5 py-4 leading-relaxed text-muted-foreground","children":"No. An LLP cannot issue equity shares."}],["$","td",null,{"className":"px-5 py-4 leading-relaxed text-muted-foreground","children":"No. Capital can only come from existing or newly admitted partners."}],["$","td",null,{"className":"px-5 py-4 leading-relaxed text-muted-foreground","children":"No. There is no mechanism to bring in an investor without changing structure."}]]}]
34:["$","tr","Compliance level",{"className":"align-top","children":[["$","th",null,{"scope":"row","className":"sticky left-0 z-10 bg-card px-5 py-4 font-semibold text-secondary","children":"Compliance level"}],["$","td",null,{"className":"px-5 py-4 leading-relaxed text-muted-foreground","children":"Highest. Statutory audit from the first year, annual ROC filings, board meetings and minutes."}],["$","td",null,{"className":"px-5 py-4 leading-relaxed text-muted-foreground","children":"Moderate. Form 8 and Form 11 annually; audit only if turnover exceeds ₹40 lakh or contribution exceeds ₹25 lakh."}],["$","td",null,{"className":"px-5 py-4 leading-relaxed text-muted-foreground","children":"Low. No annual ROC filing. Income tax return and any GST obligations apply."}],["$","td",null,{"className":"px-5 py-4 leading-relaxed text-muted-foreground","children":"Lowest. No ROC filing. Obligations follow the registrations held, plus the proprietor's own income tax return."}]]}]
