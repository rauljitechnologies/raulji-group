# Lead CRM. Server-only: this key must never be prefixed NEXT_PUBLIC_.
# The previous build shipped this key in client-side JavaScript, so rotate it
# in the CRM before going live.
RAULJI_CRM_API_KEY=
RAULJI_CRM_BASE=https://api.raulji.com/api/v1

# Supabase, read-only, used server-side for the blog and team pages.
# Leave unset and those pages render their empty state instead of failing.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google Tag Manager container ID, e.g. GTM-XXXXXXX. Optional.
# Leave unset and no tag manager script loads at all: the site still pushes its
# events onto window.dataLayer, they simply have nowhere to go. A GTM container
# ID is public by design, so NEXT_PUBLIC_ is correct and is not a secret leak.
NEXT_PUBLIC_GTM_ID=
