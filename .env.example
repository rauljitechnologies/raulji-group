# Lead CRM. Server-only: this key must never be prefixed NEXT_PUBLIC_.
# The previous build shipped this key in client-side JavaScript, so rotate it
# in the CRM before going live.
RAULJI_CRM_API_KEY=replace_with_rotated_key
RAULJI_CRM_BASE=https://crm.raulji.com/api/v1

# Transactional email, for the customer confirmation and the admin notification
# that follow a confirmed CRM capture. Server-only, like the CRM key.
#
# The adapter in lib/email/provider.ts talks to Resend's REST API. Swapping
# provider is that one file; nothing above it knows which one is behind it.
#
# EMAIL_FROM_ADDRESS must be an address the provider has verified for the
# raulji.com domain (SPF and DKIM records published, domain showing as verified
# in the provider dashboard). Until that is done, sending will fail with a
# provider 4xx and the lead is still captured -- the emails are downstream of
# the CRM and cannot fail a submission.
#
# A visitor can never influence the From header: it comes from here only, and
# the customer's own address is used as Reply-To on the admin notification.
EMAIL_PROVIDER_API_KEY=replace_with_provider_api_key
EMAIL_FROM_ADDRESS=admin@raulji.com

# Optional. Defaults to Resend's endpoint and should be left unset in
# production. Exists so the pipeline can be verified against a local mock
# before provider credentials and DNS verification are in place, and so a move
# to a provider with a compatible JSON body needs no code change.
EMAIL_PROVIDER_ENDPOINT=

# Admin notification recipients, comma-separated. Both are configured per the
# integration brief. Entries that are not addresses are ignored, so a trailing
# comma cannot turn into an empty recipient and a provider-side 400.
RAULJI_ADMIN_EMAILS=admin@raulji.com,toyuvrajraulji@gmail.com

# Supabase, read-only, used server-side for the blog and team pages.
# Leave unset and those pages render their empty state instead of failing.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google Tag Manager container ID. The client's container is GTM-MSW79R28.
#
# Deliberately left blank here rather than pre-filled: a value in this file
# would be copied into every developer's .env.local and every preview
# deployment, and their traffic would land in the client's production
# analytics. Set it in Vercel's Production environment only.
#
# Unset, no container script loads: the site still pushes its events onto
# window.dataLayer, they simply have nowhere to go. So leaving this out of
# production records NOTHING, with no visible symptom on the page --
# DEPLOYMENT.md carries a curl check for exactly that.
#
# A GTM container ID is public by design, so NEXT_PUBLIC_ is correct here and
# is not a secret leak.
NEXT_PUBLIC_GTM_ID=

# GA4 measurement ID for the raulji.com web data stream: G-SK8N5N3WE2
# (supplied by the owner on 2026-10-23). Public by design, like the container
# ID above.
#
# LEAVE THIS BLANK unless you know GTM has no GA4 Configuration tag.
#
# The recommended setup is GA4 *inside* GTM-MSW79R28, because the container is
# already consent-gated and every custom event this site pushes needs a GTM tag
# to reach GA4 regardless. Setting the variable below instead loads gtag.js
# directly, which gives page views only -- and if GTM also has a GA4
# Configuration tag, both send their own page_view and every session and user
# count inflates with no warning anywhere in GA4.
#
# Exactly one of the two. See docs/analytics-implementation.md.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
