# Lead CRM. Server-only: this key must never be prefixed NEXT_PUBLIC_.
# The previous build shipped this key in client-side JavaScript, so rotate it
# in the CRM before going live.
RAULJI_CRM_API_KEY=
RAULJI_CRM_BASE=https://api.raulji.com/api/v1

# Supabase, read-only, used server-side for the blog and team pages.
# Leave unset and those pages render their empty state instead of failing.
SUPABASE_URL=
SUPABASE_ANON_KEY=
